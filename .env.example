# Local development only. Shared engine configuration stays per deployment.
PROJECT_NAME=arkhiv-live-music
POSTGRES_DB=arkhiv_live_music
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=5173
COLLECTION_POLICY=source_stream
# Only initial local-preservation setup uses these reviewed byte limits.
MEDIA_BUDGET=0
MEDIA_RESERVE=0
# For development override, point at the canonical Arkhiv feature checkout.
# ARKHIV_CORE_SOURCE=/absolute/path/to/arkhiv
# Import/correction/manifest inputs, mounted read-only into operator containers.
IMPORT_ROOT=./data/imports
